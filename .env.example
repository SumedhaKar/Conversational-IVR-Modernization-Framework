# Copy to .env and adjust as needed. Every value below is the built-in
# default, so the app runs with no configuration at all: `npm start` works
# out of the box. Do not commit your real .env — it is gitignored.

# Port to listen on. Hosting platforms usually inject this themselves.
PORT=3000

# "production" tightens the CORS default (see below). Anything else is
# treated as development.
NODE_ENV=development

# Winston log level: error | warn | info | http | verbose | debug | silly
LOG_LEVEL=info

# Path for the plain log file. Rotated application/error logs are written
# to ./logs regardless. Note that on platforms with an ephemeral filesystem
# these files do not survive a restart — rely on the console output there.
LOG_FILE=./logs/middleware.log

# --- BAP service ---

# BAP endpoint. Leave unset to use built-in mock responses.
# The bundled BAP service (npm run bap) listens here by default:
# BAP_API_URL=http://localhost:4001/bap/intent

# Force mock BAP responses even when BAP_API_URL is set. Must be the exact
# string "true" to take effect.
USE_BAP_MOCK=false

# How long to wait for BAP before falling back to mock data. Keep it short —
# a caller waiting on a dead dependency is worse than a synthetic answer.
BAP_TIMEOUT_MS=5000

# --- BAP service itself (read only by bap-service/server.js) ---

# Port the BAP service listens on.
BAP_PORT=4001

# Artificial delay on every BAP response, for exercising the middleware's
# timeout and fallback path. Leave at 0 outside that testing.
BAP_LATENCY_MS=0

# --- CORS ---

# Comma-separated origins allowed to call the API cross-origin. Empty means
# same-origin only, which is all the bundled UI needs since this app serves
# it. Requests with no Origin header (curl, Postman, server-to-server) are
# unaffected either way.
#
# In development, localhost and 127.0.0.1 origins are additionally allowed
# so a separate frontend dev server works without extra setup. Set
# NODE_ENV=production to turn that off and rely on this list alone.
# CORS_ORIGINS=https://ivr.example.com,https://admin.example.com
